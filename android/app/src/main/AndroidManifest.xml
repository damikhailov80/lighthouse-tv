<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android TV has no touchscreen; the app must not require one. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Writing our own row of cards to the Google TV home screen. Normal, so
         it is granted at install; the provider scopes every read and write to
         this package, so it grants no sight of anyone else's channels. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <!-- singleTask so a card selected on the home screen while the app is
             already running navigates the page it finds (onNewIntent) instead
             of stacking a second copy of the dashboard behind it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LAUNCHER shows it on phones/tablets, LEANBACK_LAUNCHER on TV. -->
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Where the home screen's cards lead: lighthouse://activity/<id>.
                 An implicit scheme rather than a component of ours, so the same
                 link can be fired from adb to test the route without the TV
                 launcher being involved at all. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="lighthouse"
                    android:host="activity" />
            </intent-filter>
        </activity>

        <!-- The screensaver. Bound by the system, never started by the app, so
             it is exported and guarded by the system's own permission. -->
        <service
            android:name=".AmbientDream"
            android:exported="true"
            android:label="@string/dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream_info" />
        </service>
    </application>
</manifest>
