# Installed by npm, reproducible from package-lock.json.
node_modules/

# Build output. The single-file bundle is regenerated by every build and copied
# into the APK by android/sync-web.sh, so the only copy worth keeping is the
# source it is built from.
dist/

# Local environment: connection strings and the device token. .env.example
# carries the shape of the file without any of the values.
.env
.env.local

# macOS.
.DS_Store
