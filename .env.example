# Copy to .env and adjust. .env is gitignored — it carries the device token.

# The development database from docker-compose.yml. The deployed API gets its
# own value.
DATABASE_URL=postgresql://lighthouse:lighthouse@localhost:5432/lighthouse

API_PORT=3000

# Shared secret every client sends as `Authorization: Bearer <token>`. There is
# no sign-in yet: one household, one list. This is what keeps a backend that is
# reachable around the clock from being a list anyone can rewrite, and it is the
# seam real authentication will replace — see AuthGuard and TenantContext.
DEVICE_TOKEN=change-me

# Which midnight the day's picks turn over on. The server decides "today" for
# every screen, so this is set once for the household rather than read off each
# device — a television and a photo frame must not disagree about what day it is.
HOUSEHOLD_TZ=Europe/Moscow
