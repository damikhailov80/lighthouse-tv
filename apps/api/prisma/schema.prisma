generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A recurring activity the user wants to keep up with. Mirrors the Activity
// type in @lighthouse/shared, plus the columns a shared list needs that a
// single device's localStorage never did.
model Activity {
  // Generated by the client (crypto.randomUUID), which is what makes creation
  // idempotent: a request that is retried after an unclear failure updates the
  // row it already made instead of adding a second one. A plain String rather
  // than a uuid column because the seed records are "1".."9".
  id String @id

  // The one column between one household and many. Filled from TenantContext,
  // never from a request body — see AuthGuard. Real authentication replaces
  // where the value comes from and leaves everything downstream alone.
  householdId String @default("default") @map("household_id")

  title      String
  every      Int
  // "day" | "week" | "month". A string and not a Postgres enum for the same
  // reason `image` is: adding a value should not need a database migration.
  unit       String
  lastDoneAt DateTime @map("last_done_at")
  // An ActivityImage key, never a URL — the bundler hashes asset URLs on every
  // build, and the launcher looks the key up in its own copy of the pictures.
  image      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // Soft delete. Deleting from a remote is two presses of the D-pad and has to
  // be recoverable, and a hard delete would take the completion history with
  // it. Rows are cleared out on a schedule — see CleanupService.
  deletedAt DateTime? @map("deleted_at")

  completions Completion[]

  @@index([householdId, updatedAt])
  @@index([householdId, deletedAt])
  @@map("activities")
}

// One "marked as done". The list itself only remembers the last time, because
// that is all the traffic light needs; this is the history behind it, which
// overwriting lastDoneAt used to destroy and which cannot be recovered later.
model Completion {
  id         String   @id @default(uuid())
  activityId String   @map("activity_id")
  doneAt     DateTime @map("done_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, doneAt])
  @@map("completions")
}

// The day's decisions: which activity the banner features and which rows the
// dashboard dealt. Frozen once per day so that marking something done recolours
// a card where it stands instead of rearranging the screen — and stored per
// household rather than per device, so the television, the web and a photo
// frame name the same thing.
model DayPick {
  householdId String @map("household_id")
  // dayKey() from @lighthouse/shared, resolved in the household's timezone.
  day         String

  heroId String? @map("hero_id")
  // DayLayout["rows"]: [{ id, title, activityIds }]. Json because it is read
  // and written whole and never queried into — it is one screen's decision,
  // not a relation.
  rows Json

  createdAt DateTime @default(now()) @map("created_at")

  // The composite key is also the race guard: several clients opening the app
  // at once on a new day all try to insert, one wins, and the rest read what
  // it wrote.
  @@id([householdId, day])
  @@map("day_picks")
}
